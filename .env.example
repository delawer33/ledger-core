# Copy to .env and fill in. The real .env is never committed.

# --- API ---
API_PORT_INTERNAL=8000
API_PORT_EXTERNAL=8000
ENVIRONMENT=local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database ---
# Host-side URL for running the app or tests outside Docker (compose publishes the DB here).
DATABASE_URL=postgres://ledger:ledger@127.0.0.1:55433/ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
# Host port for the compose Postgres; deliberately not 5432.
DB_PORT_EXTERNAL=55433

# --- Admin ---
# `seed` creates this superuser for the read-only admin at /admin/ (skipped when unset or when
# ENVIRONMENT=production). Dev values only.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
