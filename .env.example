# Copy to .env and fill in. The real .env is never committed.

# --- API ---
API_PORT_INTERNAL=8000
API_PORT_EXTERNAL=8000
ENVIRONMENT=local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database ---
# Host-side URL for running the app or tests outside Docker (compose publishes the DB here).
DATABASE_URL=postgres://ledger:ledger@127.0.0.1:55433/ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
# Host port for the compose Postgres; deliberately not 5432.
DB_PORT_EXTERNAL=55433

# --- Admin ---
# `seed` creates this superuser for the read-only admin at /admin/ only when BOTH username and
# password are set (and never when ENVIRONMENT=production). Left empty on purpose: pick your own.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
OUTBOX_RELAY_INTERVAL_SECONDS=5
# Built-in scheduler (ADR-0016): seconds between passes of each periodic task, and how often
# `run_scheduler` checks that every chain is alive.
HOLD_EXPIRY_INTERVAL_SECONDS=30
RECONCILIATION_INTERVAL_SECONDS=3600
SCHEDULER_POLL_SECONDS=15
# A chain is presumed dead this long after its next pass was due; a running pass extends its own
# lease (heartbeat), so this only bounds recovery time after a killed worker.
TASK_CHAIN_GRACE_SECONDS=60

# Load runs (docker-compose.load.yml): gunicorn processes/threads of the api
#GUNICORN_WORKERS=4
#GUNICORN_THREADS=1
